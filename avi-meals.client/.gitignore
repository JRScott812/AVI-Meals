# Client-specific .gitignore for `avi-meals.client` (Node + Vite + local dev artifacts)

# Node / package managers
node_modules/
.npm/
.yarn/
.pnpm-store/
pnpm-lock.yaml
yarn.lock

# Build output
dist/
build/
public/build/
.vite/
obj/

# Vite / tooling cache
.cache/
.parcel-cache/
.turbo/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Tests / coverage
coverage/
.nyc_output/
playwright-report/
test-results/
vitest.config.*.timestamp*

# Local env files
.env
.env.*
!.env.example
!.env.*.example

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
